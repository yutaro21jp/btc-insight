{
  "name": "btc-insight",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "sucrase": {
      "glob": "^14.0.4"
    },
    "eslint": "$eslint",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "audit": "npm audit --audit-level=low",
    "check:content": "node --import tsx scripts/check-content.ts",
    "prebuild": "npm run check:content",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
